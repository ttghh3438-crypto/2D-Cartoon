name: Build iOS App
on: [push]
jobs:
  build:
    runs-on: macos-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18
      - name: Install dependencies
        run: npm install
      - name: Init Capacitor & Add iOS
        run: |
          npm install @capacitor/core @capacitor/cli
          npx cap init app app --web-dir www --yes || true
          npx cap add ios
          npx cap sync ios
